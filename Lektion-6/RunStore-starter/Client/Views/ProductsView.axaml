<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Client.Views.ProductsView"
             x:DataType="vm:ProductsViewModel">

  <Design.DataContext>
    <vm:ProductsViewModel></vm:ProductsViewModel>
  </Design.DataContext>

  <StackPanel>
    <TextBlock Classes="pageTitle" Text="Våra produkter"/>

    <Border BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 50 0 5">
      <!-- Rubriker -->
      <Grid ColumnDefinitions="100,150,*,200,75,75">
        <Label Grid.Column="0" Content="Artikelnr" />
        <Label Grid.Column="1" Content="Leverantör" />
        <Label Grid.Column="2" Content="Produktnamn" />
        <Label Grid.Column="3" Content="Pris" HorizontalAlignment="Right" />
        <Label Grid.Column="4" HorizontalAlignment="Center" />
        <Label Grid.Column="5" HorizontalAlignment="Center" />
      </Grid>
    </Border>
    <ScrollViewer Height="400">
      <ItemsControl ItemsSource="{Binding Products}" Margin="0 10 0 0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="100,150,*,200,75,75">
              <Label Grid.Column="0" Content="{Binding ItemNumber}" />
              <Label Grid.Column="1" Content="{Binding Supplier.Name}" />
              <Label Grid.Column="2" Content="{Binding Name}" />
              <Label Grid.Column="3" Content="{Binding Price}" HorizontalAlignment="Right" />
              <Button Grid.Column="4" Classes="icon-edit" HorizontalAlignment="Center" />
              <Button Grid.Column="5" Classes="icon-delete" HorizontalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Popup IsOpen="{Binding ShowDialog}" Placement="Center">
      <Border Padding="30" Background="{DynamicResource WarningPopUpGradient}" BorderBrush="White" BorderThickness="2" CornerRadius="30">
        <StackPanel Spacing="20">
          <StackPanel Spacing="20">
            <TextBlock Padding="20" Text="Är du säker på att du vill ta bort produkten?" Foreground="White" FontSize="30" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
            <Button Classes="warning" Command="{Binding ConfirmCommand}">Ja</Button>
            <Button Classes="warning" Command="{Binding CancelCommand}">Nej</Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>

  </StackPanel>
</UserControl>
